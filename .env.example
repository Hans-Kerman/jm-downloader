# .env.example

# --- API Configuration ---
# Your API key for the vision model service.
API_KEY="your_secret_api_key_here"

# The base URL for the API endpoint.
BASE_URL="https://api.example.com/v1"

# The name of the model to use.
MODEL_NAME="gemini-2.5-flash"


# --- File Paths ---
# Path to the directory where downloaded files will be saved.
# Can be a relative or absolute path.
DOWNLOAD_PATH="downloads"

# Path to the directory containing input PNG files.
INPUT_PNG_DIR="input_images"


# --- Optional Settings ---
# Log level for the application (e.g., DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL="INFO"

# Maximum number of retries for failed API calls.
# MAX_RETRIES=3
